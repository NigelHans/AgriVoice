# Copy to mobile/.env. Local backend: your computer's LAN IP, so a phone can reach it.
# Hosted backend (Render, see README): https://<your-service>.onrender.com
EXPO_PUBLIC_BACKEND_URL=http://192.168.x.x:8000

# Optional: "true" shows sample data instead of calling the backend (UI work only).
# EXPO_PUBLIC_USE_MOCKS=true
