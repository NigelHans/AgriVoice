# Copy to backend/.env and fill in real values. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_key_here
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=*

# Optional overrides
# GROQ_STT_MODEL=whisper-large-v3
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
# PRICE_SYNC_ON_STARTUP=true
# APP_API_KEY=        # hosted backend only: voice/chat then require the X-App-Key header
